        local toast=make("Frame",{AnchorPoint=Vector2.new(1,1),Position=UDim2.new(1,-18,1,80),Size=UDim2.fromOffset(270,76),BackgroundColor3=theme.Surface,BorderSizePixel=0,ZIndex=100},screen)
        corner(toast,10); stroke(toast,theme.Stroke)
        local h=makeLabel(toast,title or "NEXUS",13,theme.Text,Enum.Font.GothamBold); h.Position=UDim2.fromOffset(12,8); h.Size=UDim2.new(1,-24,0,22); h.ZIndex=101
        local m=makeLabel(toast,message or "",11,theme.Muted); m.Position=UDim2.fromOffset(12,31); m.Size=UDim2.new(1,-24,0,34); m.TextWrapped=true; m.ZIndex=101
        tween(toast,TweenInfo.new(0.25,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{Position=UDim2.new(1,-18,1,-18)})
        task.delay(duration or 3,function()
            if toast.Parent then
                tween(toast,TweenInfo.new(0.2),{Position=UDim2.new(1,-18,1,90)})
