    local function fileApi()
        return type(writefile)=="function" and type(readfile)=="function"
            and type(isfile)=="function" and type(makefolder)=="function"
    end

    function Window:SaveConfig(name)
        name=name or configName
        local data={ThemeName=currentThemeName,Values={}}
        for _,item in ipairs(controls) do
            if item.Name and item.Type then
                local v=item.Value
                if item.Type=="Keybind" and typeof(v)=="EnumItem" then v=v.Name end
                if item.Type=="Colorpicker" and typeof(v)=="Color3" then v={v.R,v.G,v.B} end
                data.Values[item.Name]={Type=item.Type,Value=v}
            end
        end
        local encoded=HttpService:JSONEncode(data)
        if fileApi() then
            pcall(function()
                if not isfolder or not isfolder(configFolder) then makefolder(configFolder) end
                writefile(configFolder.."/"..name..".json",encoded)
            end)
            self:Notify("Configuration saved",name,2)
            return true
        end
        self._MemoryConfig=self._MemoryConfig or {}
        self._MemoryConfig[name]=encoded
        self:Notify("Saved in memory", "This executor does not expose file APIs.", 3)
        return true
    end

    function Window:LoadConfig(name)
        name=name or configName
        local encoded
        if fileApi() then
            local path=configFolder.."/"..name..".json"
            if isfile(path) then
                local ok,result=pcall(readfile,path)
                if ok then encoded=result end
            end
        elseif self._MemoryConfig then
            encoded=self._MemoryConfig[name]
        end
        if not encoded then self:Notify("Config not found",name,3); return false end
        local ok,data=pcall(function() return HttpService:JSONDecode(encoded) end)
        if not ok or type(data)~="table" then self:Notify("Load failed","Invalid configuration file.",3); return false end
        if data.ThemeName then applyTheme(data.ThemeName) end
        for _,item in ipairs(controls) do
            local saved=item.Name and data.Values and data.Values[item.Name]
            if saved and saved.Type==item.Type and item.Set then
                local value=saved.Value
                if item.Type=="Keybind" and type(value)=="string" then
                    local enum=Enum.KeyCode[value]
                    if enum then value=enum end
                elseif item.Type=="Colorpicker" and type(value)=="table" then
                    value=Color3.new(value[1],value[2],value[3])
                end
                pcall(item.Set,value)
            end
        end
        self:Notify("Configuration loaded",name,2)
        return true
    end

    local function collectFadeTargets()
        local records = {}
        local objects = {root}
        for _, descendant in ipairs(root:GetDescendants()) do
            table.insert(objects, descendant)
        end
        for _, object in ipairs(objects) do
            local properties = {}
            if object:IsA("GuiObject") then
                local ok, value = pcall(function() return object.BackgroundTransparency end)
                if ok then properties.BackgroundTransparency = value end
                if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
                    properties.TextTransparency = object.TextTransparency
                end
                if object:IsA("ImageLabel") or object:IsA("ImageButton") then
                    properties.ImageTransparency = object.ImageTransparency
                end
            elseif object:IsA("UIStroke") then
                properties.Transparency = object.Transparency
            end
            if next(properties) then
                table.insert(records, {Object = object, Original = properties})
            end
        end
        return records
    end

    local function fadeObjects(records, target, duration)
        for _, record in ipairs(records) do
            if record.Object and record.Object.Parent then
                local props = {}
                for property in pairs(record.Original) do props[property] = target end
                pcall(function()
                    tween(record.Object, TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
                end)
            end
        end
    end

    local function restoreFade(records)
        for _, record in ipairs(records) do
            if record.Object and record.Object.Parent then
                pcall(function()
                    for property, value in pairs(record.Original) do
                        record.Object[property] = value
                    end
                end)
            end
        end
    end

    local function animateWindow(opening, style)
        style = string.lower(tostring(style or (opening and defaultOpenAnimation or defaultCloseAnimation)))
        if style == "none" or style == "instant" then
            root.Visible = opening
            root.Size = defaultWindowSize
            root.Position = UDim2.fromScale(0.5, 0.5)
            rootScale.Scale = 1
            windowVisible = opening
            return
        end
        if animationBusy then return end
        animationBusy = true
        local duration = animationDuration
        if opening then
            windowVisible = true
            root.Visible = true
            if style == "slide" then
                root.Position = UDim2.new(0.5, 0, 1.25, 0)
                tween(root, TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                    Position = UDim2.fromScale(0.5, 0.5), Size = defaultWindowSize
                })
            elseif style == "fade" then
                root.Size = defaultWindowSize
                root.Position = UDim2.fromScale(0.5, 0.5)
                local records = collectFadeTargets()
                for _, record in ipairs(records) do
                    if record.Object and record.Object.Parent then
                        pcall(function()
                            for property in pairs(record.Original) do record.Object[property] = 1 end
                        end)
                    end
                end
                fadeObjects(records, 0, duration)
            else
                root.Position = UDim2.fromScale(0.5, 0.5)
                root.Size = defaultWindowSize
                rootScale.Scale = 0.72
                tween(rootScale, TweenInfo.new(duration, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                    Scale = 1
                })
            end
            task.delay(duration + 0.04, function() animationBusy = false end)
        else
            windowVisible = false
            if style == "slide" then
                local t = tween(root, TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
                    Position = UDim2.new(0.5, 0, 1.25, 0)
                })
                task.delay(duration + 0.03, function()
                    root.Visible = false
                    root.Position = UDim2.fromScale(0.5, 0.5)
                    root.Size = defaultWindowSize
                    animationBusy = false
                end)
            elseif style == "fade" then
                local records = collectFadeTargets()
                fadeObjects(records, 1, duration)
                task.delay(duration + 0.03, function()
                    root.Visible = false
                    restoreFade(records)
                    animationBusy = false
                end)
            else
                tween(rootScale, TweenInfo.new(duration, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
                    Scale = 0.72
                })
                task.delay(duration + 0.03, function()
                    root.Visible = false
                    root.Size = defaultWindowSize
                    rootScale.Scale = 1
                    animationBusy = false
                end)
            end
        end
    end

    function Window:Open(animation)
        if windowVisible and root.Visible and not animationBusy then return end
        animateWindow(true, animation)
    end

    function Window:Close(animation)
        if not windowVisible or not root.Visible or animationBusy then return end
        animateWindow(false, animation)
    end

    function Window:SetOpen(state, animation)
        if state then self:Open(animation) else self:Close(animation) end
    end

    function Window:Toggle(animation)
        if windowVisible then self:Close(animation) else self:Open(animation) end
    end

    function Window:Destroy()
        screen:Destroy()
    end

    minimize.MouseButton1Click:Connect(function()
        body.Visible = not body.Visible
        if body.Visible then
            root.Size = defaultWindowSize
        else
            root.Size = UDim2.new(defaultWindowSize.X.Scale, defaultWindowSize.X.Offset, 0, 58)
        end
    end)

    -- Dragging works with mouse and touch.
    local dragging, dragStart, startPos
    top.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            dragging=true; dragStart=input.Position; startPos=root.Position
            input.Changed:Connect(function()
                if input.UserInputState==Enum.UserInputState.End then dragging=false end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
            local delta=input.Position-dragStart
            root.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,startPos.Y.Scale,startPos.Y.Offset+delta.Y)
        end
    end)

    self._LastWindow=Window

    if options.AnimateOnCreate ~= false then
        root.Size = UDim2.fromOffset(0, 0)
        animateWindow(true, defaultOpenAnimation)
    end

    return Window
end

Nexus.Themes = Themes
