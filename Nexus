--[[
    NEXUS UI v1.2
    Modern premium Roblox UI library for executor environments.
    UI framework only: no gameplay automation or remote-event functionality.

    Usage:
        local Nexus = loadstring(readfile("Nexus.lua"))()
        local Window = Nexus:CreateWindow({
            Title = "My Hub",
            Subtitle = "NEXUS UI",
            Theme = "Midnight",
            ConfigFolder = "NexusConfigs",
            OpenAnimation = "Scale", -- Scale, Slide, Fade, None
            CloseAnimation = "Fade", -- Scale, Slide, Fade, None
            AnimationDuration = 0.25
        })

        local Main = Window:Tab("Main")
        local Section = Main:Section("General")
        Section:Button({Name="Example", Icon=123456789, Image=987654321, Callback=function() print("Clicked") end})
        Section:Button({Name="Card action", Style="Card", Description="A large clickable row", Image=123456789, Callback=function() print("Card") end})
        Section:Toggle({Name="Enabled", Style="Card", Description="A rectangle toggle", Icon=123456789, Default=false, Callback=function(v) print(v) end})
        Section:Slider({Name="Amount", Min=0, Max=100, Default=50, Callback=function(v) print(v) end})
        Section:Dropdown({Name="Mode", Options={"A","B","C"}, Default="A", Callback=function(v) print(v) end})
        Section:Textbox({Name="Text", Default="", Placeholder="Type here...", Callback=function(v) print(v) end})
        Section:Keybind({Name="Toggle UI", Default=Enum.KeyCode.RightControl, Callback=function() Window:Toggle() end})
        Section:Colorpicker({Name="Accent", Default=Color3.fromRGB(124, 92, 255), Callback=function(c) print(c) end})
]]

