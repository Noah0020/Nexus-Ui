        function Section:Colorpicker(opts)
            opts=opts or {}
            local color=opts.Default or theme.Accent
            local row,label=rowBase(opts.Name or "Color",40)
            local swatch=make("TextButton",{Text="HEX",TextSize=10,Font=Enum.Font.GothamBold,TextColor3=Color3.new(1,1,1),BackgroundColor3=color,Size=UDim2.fromOffset(62,26),Position=UDim2.new(1,-72,0.5,-13),BorderSizePixel=0,AutoButtonColor=false},row)
            corner(swatch,7)
            local editor=make("TextBox",{Text="",PlaceholderText="#7C5CFF",TextSize=10,Font=Enum.Font.Gotham,TextColor3=theme.Text,PlaceholderColor3=theme.Muted,BackgroundColor3=theme.Background,BorderSizePixel=0,Size=UDim2.fromOffset(90,26),Position=UDim2.new(1,-170,0.5,-13),Visible=false},row)
            corner(editor,7)
            local item={Type="Colorpicker",Value=color,Name=opts.Name}
            swatch.MouseButton1Click:Connect(function() editor.Visible=not editor.Visible end)
            editor.FocusLost:Connect(function()
                local hex=editor.Text:gsub("#","")
                if #hex==6 then
                    local r=tonumber(hex:sub(1,2),16); local g=tonumber(hex:sub(3,4),16); local b=tonumber(hex:sub(5,6),16)
                    if r and g and b then color=Color3.fromRGB(r,g,b); item.Value=color; swatch.BackgroundColor3=color; safeCallback(opts.Callback,color) end
                end
                editor.Visible=false
            end)
            item.Set=function(c) if typeof(c)=="Color3" then color=c; item.Value=c; swatch.BackgroundColor3=c; safeCallback(opts.Callback,c) end end
            item.RefreshTheme=function(t) row.BackgroundColor3=t.Surface2; label.TextColor3=t.Text; editor.BackgroundColor3=t.Background; editor.TextColor3=t.Text; editor.PlaceholderColor3=t.Muted end
            table.insert(controls,item)
            return item
        end

        return Section
    end

    function Window:Tab(name, icon)
        if type(name) == "table" then
            icon = name.Icon or icon
            name = name.Name or name.Title or "Tab"
        end
        local page = make("ScrollingFrame", {
            Name = tostring(name),
            Size = UDim2.fromScale(1,1),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = theme.Accent,
            CanvasSize = UDim2.new(),
            Visible = false
        }, content)
        local pageLayout = addList(page, 10)
        pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            page.CanvasSize = UDim2.fromOffset(0, pageLayout.AbsoluteContentSize.Y + 8)
        end)
        local tabButton = make("TextButton", {
            Text = tostring(name),
            TextSize = 12, Font = Enum.Font.GothamSemibold,
            TextColor3 = theme.Muted, BackgroundColor3 = theme.Surface2,
            Size = UDim2.new(1,0,0,35), BorderSizePixel = 0,
            AutoButtonColor = false,
            TextXAlignment = icon and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center
        }, tabList)
