local function make(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

local function corner(parent, radius)
    make("UICorner", {CornerRadius = UDim.new(0, radius or 8)}, parent)
end

local function stroke(parent, color, transparency)
    return make("UIStroke", {
        Color = color or Color3.fromRGB(50, 50, 60),
        Transparency = transparency or 0,
        Thickness = 1
    }, parent)
end

local function tween(object, info, properties)
    local t = TweenService:Create(object, info, properties)
    t:Play()
    return t
end

local function normalizeImage(image)
    if image == nil then return nil end
    if type(image) == "number" then
        return "rbxassetid://" .. tostring(image)
    end
    if type(image) ~= "string" or image == "" then return nil end
    if image:match("^%d+$") then
        return "rbxassetid://" .. image
    end
    return image
end

local function addImage(parent, image, size, position, zIndex)
    local asset = normalizeImage(image)
    if not asset then return nil end
    return make("ImageLabel", {
        Name = "NexusIcon",
        BackgroundTransparency = 1,
        Image = asset,
        ScaleType = Enum.ScaleType.Fit,
        Size = size or UDim2.fromOffset(18, 18),
        Position = position or UDim2.fromOffset(8, 8),
        ZIndex = zIndex or 2
    }, parent)
end

local function safeCallback(callback, ...)
    if type(callback) ~= "function" then
        return
    end

    -- Pack arguments before entering the spawned function.
    local args = table.pack(...)

    task.spawn(function()
        local ok, err = pcall(function()
            callback(table.unpack(args, 1, args.n))
        end)

        if not ok then
            warn("[NEXUS UI] Callback error:", err)
        end
    end)
end

local function getParent()
    -- Prefer the executor's hidden UI container when available.
    if type(gethui) == "function" then
        local ok, result = pcall(gethui)
        if ok and typeof(result) == "Instance" then
            return result
        end
    end

    -- CoreGui may exist but may reject parenting in some environments.
    local ok, coreGui = pcall(function()
        return game:GetService("CoreGui")
    end)
    if ok and coreGui then
        return coreGui
    end

    return LocalPlayer:WaitForChild("PlayerGui")
end

local function makeLabel(parent, text, size, color, font)
    return make("TextLabel", {
        BackgroundTransparency = 1,
        Text = text or "",
        TextColor3 = color,
        TextSize = size or 13,
        Font = font or Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        Size = UDim2.new(1, 0, 1, 0)
    }, parent)
end

local function addList(parent, padding)
    return make("UIListLayout", {
        Padding = UDim.new(0, padding or 7),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, parent)
end

function Nexus:GetThemes()
    local names = {}
    for name in pairs(Themes) do table.insert(names, name) end
    table.sort(names)
    return names
end

function Nexus:CreateWindow(options)
    options = options or {}
    local currentThemeName = Themes[options.Theme or "Midnight"] and (options.Theme or "Midnight") or "Midnight"
    local theme = Themes[currentThemeName]
    local configFolder = options.ConfigFolder or "NexusConfigs"
    local configName = options.ConfigName or "default"
    local controls = {}
    local tabs = {}
    local activeTab
    local windowVisible = true
    local Window = {}
    local animationBusy = false
    local animationDuration = math.clamp(tonumber(options.AnimationDuration) or 0.22, 0.05, 1.5)
    local defaultOpenAnimation = options.OpenAnimation or "Scale"
    local defaultCloseAnimation = options.CloseAnimation or "Scale"

    -- Fit the default window to the current screen, especially on phones.
    local camera = workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
    local windowWidth = math.max(280, math.min(650, viewport.X - 24))
    local windowHeight = math.max(220, math.min(440, viewport.Y - 48))
    local defaultWindowSize = options.Size or UDim2.fromOffset(windowWidth, windowHeight)
    local compactLayout = UserInputService.TouchEnabled and viewport.X < 600
    local sidebarWidth = compactLayout and math.clamp(math.floor(windowWidth * 0.30), 90, 120) or 150

    local screen = make("ScreenGui", {
        Name = "NEXUS_UI_" .. tostring(math.random(1000, 9999)),
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        ResetOnSpawn = false
    })

    local parentOk = pcall(function()
        screen.Parent = getParent()
    end)
    if not parentOk or not screen.Parent then
        local playerGui = LocalPlayer:WaitForChild("PlayerGui")
        screen.Parent = playerGui
    end
    if not screen.Parent then
        error("[NEXUS UI] Could not parent ScreenGui to an available UI container")
    end

    local root = make("Frame", {
        Name = "Root",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = defaultWindowSize,
        BackgroundColor3 = theme.Background,
        BorderSizePixel = 0
    }, screen)
    corner(root, 13)
    local rootStroke = stroke(root, theme.Stroke)
    local rootScale = make("UIScale", {Scale = 1}, root)
    make("UISizeConstraint", {
        MinSize = Vector2.new(math.min(280, windowWidth), math.min(220, windowHeight)),
        MaxSize = Vector2.new(1000, 800)
    }, root)

    local top = make("Frame", {
        Name = "Topbar",
        Size = UDim2.new(1, 0, 0, 58),
        BackgroundColor3 = theme.Surface,
        BorderSizePixel = 0
    }, root)
    corner(top, 13)
    local topMask = make("Frame", {
        Position = UDim2.new(0, 0, 1, -13),
        Size = UDim2.new(1, 0, 0, 13),
        BackgroundColor3 = theme.Surface,
        BorderSizePixel = 0
    }, top)

    local brand = makeLabel(top, options.Title or "NEXUS UI", 16, theme.Text, Enum.Font.GothamBold)
    brand.Position = UDim2.fromOffset(18, 5)
    brand.Size = UDim2.new(0.6, -18, 0, 25)
    local subtitle = makeLabel(top, options.Subtitle or "MODULAR INTERFACE", 9, theme.Muted, Enum.Font.GothamMedium)
    subtitle.Position = UDim2.fromOffset(19, 31)
    subtitle.Size = UDim2.new(0.7, -20, 0, 14)

    local close = make("TextButton", {
        Text = "×", TextSize = 23, Font = Enum.Font.Gotham,
        TextColor3 = theme.Muted, BackgroundColor3 = theme.Surface2,
        Size = UDim2.fromOffset(32, 30), Position = UDim2.new(1, -45, 0, 14),
        BorderSizePixel = 0, AutoButtonColor = false
    }, top)
    corner(close, 8)
    close.MouseButton1Click:Connect(function()
        if Window.Close then Window:Close() else screen:Destroy() end
    end)

    local minimize = make("TextButton", {
        Text = "–", TextSize = 20, Font = Enum.Font.Gotham,
        TextColor3 = theme.Muted, BackgroundColor3 = theme.Surface2,
        Size = UDim2.fromOffset(32, 30), Position = UDim2.new(1, -83, 0, 14),
        BorderSizePixel = 0, AutoButtonColor = false
    }, top)
    corner(minimize, 8)

    local body = make("Frame", {
        Position = UDim2.fromOffset(0, 58),
        Size = UDim2.new(1, 0, 1, -58),
        BackgroundTransparency = 1
    }, root)

    local sidebar = make("Frame", {
        Position = UDim2.fromOffset(12, 12),
        Size = UDim2.new(0, sidebarWidth, 1, -24),
        BackgroundColor3 = theme.Surface,
        BorderSizePixel = 0
    }, body)
    corner(sidebar, 10)
    local tabList = make("ScrollingFrame", {
        Position = UDim2.fromOffset(8, 8),
        Size = UDim2.new(1, -16, 1, -16),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = theme.Accent,
        CanvasSize = UDim2.new()
    }, sidebar)
    local tabLayout = addList(tabList, 5)
    tabLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        tabList.CanvasSize = UDim2.fromOffset(0, tabLayout.AbsoluteContentSize.Y + 5)
    end)

    local content = make("Frame", {
        Position = UDim2.new(0, sidebarWidth + 24, 0, 12),
        Size = UDim2.new(1, -(sidebarWidth + 36), 1, -24),
        BackgroundTransparency = 1
    }, body)

    local function applyTheme(nextTheme)
        if type(nextTheme) == "string" then
            if not Themes[nextTheme] then return end
            currentThemeName = nextTheme
            nextTheme = Themes[nextTheme]
        else
            currentThemeName = "Custom"
        end
        if type(nextTheme) ~= "table" then return end
        theme = nextTheme
        root.BackgroundColor3 = theme.Background
        rootStroke.Color = theme.Stroke
        top.BackgroundColor3 = theme.Surface
        topMask.BackgroundColor3 = theme.Surface
        brand.TextColor3 = theme.Text
        subtitle.TextColor3 = theme.Muted
        close.TextColor3 = theme.Muted
        close.BackgroundColor3 = theme.Surface2
        minimize.TextColor3 = theme.Muted
        minimize.BackgroundColor3 = theme.Surface2
        sidebar.BackgroundColor3 = theme.Surface
        for _, tab in ipairs(tabs) do
            tab.Button.BackgroundColor3 = tab == activeTab and theme.Accent or theme.Surface2
            tab.Button.TextColor3 = tab == activeTab and theme.OnAccent or theme.Muted
        end
        for _, item in ipairs(controls) do
            if item.RefreshTheme then pcall(item.RefreshTheme, theme) end
        end
    end

    local function setTab(tab)
        activeTab = tab
        for _, t in ipairs(tabs) do
            t.Page.Visible = t == tab
            t.Button.BackgroundColor3 = t == tab and theme.Accent or theme.Surface2
            t.Button.TextColor3 = t == tab and theme.OnAccent or theme.Muted
        end
    end

    local function makeSection(tab, title, sectionIcon)
        if type(title) == "table" then
            sectionIcon = title.Icon or sectionIcon
            title = title.Name or title.Title or "Section"
        end
        local sectionFrame = make("Frame", {
            BackgroundColor3 = theme.Surface,
            BorderSizePixel = 0,
            Size = UDim2.new(1, -8, 0, 50),
            AutomaticSize = Enum.AutomaticSize.Y
        }, tab.Page)
        corner(sectionFrame, 10)
        stroke(sectionFrame, theme.Stroke)
        local heading = makeLabel(sectionFrame, title or "Section", 12, theme.Text, Enum.Font.GothamBold)
        heading.Position = UDim2.fromOffset(sectionIcon and 36 or 12, 7)
        heading.Size = UDim2.new(1, sectionIcon and -48 or -24, 0, 22)
        if sectionIcon then
            addImage(sectionFrame, sectionIcon, UDim2.fromOffset(18, 18), UDim2.fromOffset(12, 9), 3)
        end
        local holder = make("Frame", {
            Position = UDim2.fromOffset(10, 34),
            Size = UDim2.new(1, -20, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1
        }, sectionFrame)
        local layout = addList(holder, 7)
        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            holder.Size = UDim2.new(1, -20, 0, layout.AbsoluteContentSize.Y)
            sectionFrame.Size = UDim2.new(1, -8, 0, layout.AbsoluteContentSize.Y + 44)
        end)

        local Section = {}

        local function rowBase(name, height)
            local row = make("Frame", {
                Size = UDim2.new(1, 0, 0, height or 38),
                BackgroundColor3 = theme.Surface2,
                BorderSizePixel = 0
            }, holder)
            corner(row, 8)
            local label = makeLabel(row, name or "Control", 12, theme.Text, Enum.Font.GothamMedium)
            label.Position = UDim2.fromOffset(10, 0)
            label.Size = UDim2.new(1, -20, 1, 0)
            return row, label
        end

        function Section:Button(opts)
            opts = opts or {}
            local style = string.lower(tostring(opts.Style or "Button"))
            local isCard = style == "card" or style == "rectangle"

            if isCard then
                local card = make("TextButton", {
                    Name = opts.Name or "ActionCard",
                    Text = "",
                    Size = UDim2.new(1, 0, 0, opts.Height or 58),
                    BackgroundColor3 = theme.Surface2,
                    BorderSizePixel = 0,
                    AutoButtonColor = false
                }, holder)
                corner(card, 9)
                local icon = opts.Image or opts.Icon
                if icon then
                    addImage(card, icon, UDim2.fromOffset(30, 30), UDim2.fromOffset(12, 14), 3)
                end
                local textX = icon and 52 or 12
                local titleLabel = makeLabel(card, opts.Name or "Action", 12, theme.Text, Enum.Font.GothamBold)
                titleLabel.Position = UDim2.fromOffset(textX, opts.Description and 7 or 0)
                titleLabel.Size = UDim2.new(1, -textX - 34, 1, opts.Description and -18 or 0)
                if opts.Description then
                    local description = makeLabel(card, opts.Description, 10, theme.Muted, Enum.Font.Gotham)
                    description.Position = UDim2.fromOffset(textX, 30)
                    description.Size = UDim2.new(1, -textX - 34, 0, 18)
                end
                local arrow = makeLabel(card, "›", 22, theme.Muted, Enum.Font.Gotham)
                arrow.TextXAlignment = Enum.TextXAlignment.Center
                arrow.Position = UDim2.new(1, -30, 0, 0)
                arrow.Size = UDim2.new(0, 22, 1, 0)
                card.MouseButton1Click:Connect(function()
                    tween(card, TweenInfo.new(0.08), {BackgroundColor3 = theme.Stroke})
                    task.delay(0.1, function()
                        if card.Parent then tween(card, TweenInfo.new(0.12), {BackgroundColor3 = theme.Surface2}) end
                    end)
                    safeCallback(opts.Callback)
                end)
                table.insert(controls, {RefreshTheme = function(t)
                    card.BackgroundColor3 = t.Surface2
                    titleLabel.TextColor3 = t.Text
                    arrow.TextColor3 = t.Muted
                end})
                return card
            end

            local row, label = rowBase(opts.Name or "Button", opts.Height or 38)
            if opts.Icon then
                addImage(row, opts.Icon, UDim2.fromOffset(18, 18), UDim2.fromOffset(10, 10), 3)
                label.Position = UDim2.fromOffset(36, 0)
                label.Size = UDim2.new(1, -132, 1, 0)
            end
            local hasImage = normalizeImage(opts.Image) ~= nil
            local buttonWidth = hasImage and 104 or 86
            local button = make("TextButton", {
                Text = opts.Text or "Run",
                TextSize = 11, Font = Enum.Font.GothamSemibold,
                TextColor3 = theme.OnAccent, BackgroundColor3 = theme.Accent,
                Size = UDim2.fromOffset(buttonWidth, 26), Position = UDim2.new(1, -(buttonWidth + 10), 0.5, -13),
                BorderSizePixel = 0, AutoButtonColor = false,
                TextXAlignment = hasImage and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center
            }, row)
            corner(button, 7)
            if hasImage then
                addImage(button, opts.Image, UDim2.fromOffset(18, 18), UDim2.fromOffset(7, 4), 4)
                make("UIPadding", {PaddingLeft = UDim.new(0, 30), PaddingRight = UDim.new(0, 4)}, button)
            end
            button.MouseButton1Click:Connect(function()
                tween(button, TweenInfo.new(0.08), {BackgroundTransparency = 0.25})
                task.delay(0.1, function() if button.Parent then tween(button, TweenInfo.new(0.12), {BackgroundTransparency = 0}) end end)
                safeCallback(opts.Callback)
            end)
            table.insert(controls, {RefreshTheme = function(t)
                row.BackgroundColor3 = t.Surface2
                label.TextColor3 = t.Text
                button.BackgroundColor3 = t.Accent
                button.TextColor3 = t.OnAccent
            end})
            return button
        end

        function Section:Toggle(opts)
            opts = opts or {}
            local value = opts.Default == true
            local style = string.lower(tostring(opts.Style or "Switch"))
            local isCard = style == "card" or style == "rectangle"
            local row, label = rowBase(opts.Name or "Toggle", isCard and (opts.Height or 62) or 38)
            if opts.Icon then
                addImage(row, opts.Icon, UDim2.fromOffset(20, 20), UDim2.fromOffset(10, isCard and 20 or 9), 3)
                label.Position = UDim2.fromOffset(38, isCard and 5 or 0)
                label.Size = UDim2.new(1, -100, 0, isCard and 24 or 38)
            elseif isCard then
                label.Position = UDim2.fromOffset(12, 5)
                label.Size = UDim2.new(1, -80, 0, 24)
            end
            if isCard and opts.Description then
                local description = makeLabel(row, opts.Description, 10, theme.Muted, Enum.Font.Gotham)
                description.Position = UDim2.fromOffset(opts.Icon and 38 or 12, 31)
                description.Size = UDim2.new(1, -95, 0, 22)
            end
            local cardHit
            if isCard then
                cardHit = make("TextButton", {
                    Name = "CardHitbox",
                    Text = "",
                    BackgroundTransparency = 1,
                    Size = UDim2.fromScale(1, 1),
                    ZIndex = 1,
                    AutoButtonColor = false
                }, row)
            end
            local switch = make("TextButton", {
                Text = "", Size = UDim2.fromOffset(38, 21),
                Position = UDim2.new(1, -49, 0.5, -10),
                BackgroundColor3 = value and theme.Accent or theme.Stroke,
                BorderSizePixel = 0, AutoButtonColor = false,
                ZIndex = 3
            }, row)
            corner(switch, 20)
            local knob = make("Frame", {
                Size = UDim2.fromOffset(15, 15),
                Position = value and UDim2.new(1, -18, 0.5, -7) or UDim2.fromOffset(3, 3),
                BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0,
                ZIndex = 4
            }, switch)
            corner(knob, 20)
            local item = {Type="Toggle", Value=value, Name=opts.Name}
            local function set(v, fire)
                value = not not v
                item.Value = value
                tween(switch, TweenInfo.new(0.15), {BackgroundColor3 = value and theme.Accent or theme.Stroke})
                tween(knob, TweenInfo.new(0.15), {Position = value and UDim2.new(1, -18, 0.5, -7) or UDim2.fromOffset(3, 3)})
                if fire then safeCallback(opts.Callback, value) end
            end
            switch.MouseButton1Click:Connect(function() set(not value, true) end)
            if cardHit then
                cardHit.MouseButton1Click:Connect(function() set(not value, true) end)
            end
            item.Set = function(v) set(v, true) end
            item.Get = function() return value end
            item.RefreshTheme = function(t)
                row.BackgroundColor3=t.Surface2
                label.TextColor3=t.Text
                switch.BackgroundColor3=value and t.Accent or t.Stroke
            end
            table.insert(controls, item)
            return item
        end

        function Section:Slider(opts)
            opts = opts or {}
            local min, max = opts.Min or 0, opts.Max or 100
            local value = math.clamp(opts.Default or min, min, max)
            local row, label = rowBase(opts.Name or "Slider", 52)
            label.Size = UDim2.new(1, -100, 0, 25)
            local valueLabel = makeLabel(row, tostring(value), 11, theme.Muted, Enum.Font.GothamMedium)
            valueLabel.TextXAlignment = Enum.TextXAlignment.Right
            valueLabel.Position = UDim2.new(1, -75, 0, 0)
            valueLabel.Size = UDim2.fromOffset(65, 25)
            local bar = make("Frame", {Position=UDim2.fromOffset(10, 34), Size=UDim2.new(1,-20,0,5), BackgroundColor3=theme.Stroke, BorderSizePixel=0}, row)
            corner(bar, 5)
            local fill = make("Frame", {Size=UDim2.new((value-min)/math.max(max-min, 0.0001),0,1,0), BackgroundColor3=theme.Accent, BorderSizePixel=0}, bar)
            corner(fill, 5)
            local hit = make("TextButton", {Text="", BackgroundTransparency=1, Size=UDim2.new(1,0,0,20), Position=UDim2.new(0,0,0.5,-10)}, bar)
            local item = {Type="Slider", Value=value, Name=opts.Name}
            local function setFromX(x, fire)
                local alpha = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                local raw = min + (max-min)*alpha
                local step = opts.Step or 1
                value = math.clamp(math.floor(raw/step + 0.5)*step, min, max)
                item.Value = value
                fill.Size = UDim2.new((value-min)/math.max(max-min,0.0001),0,1,0)
                valueLabel.Text = tostring(value)
                if fire then safeCallback(opts.Callback, value) end
            end
            local mouseDragging = false
            local activeTouch = nil

            hit.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    mouseDragging = true
                    setFromX(input.Position.X, true)
                elseif input.UserInputType == Enum.UserInputType.Touch then
                    activeTouch = input
                    setFromX(input.Position.X, true)
                    input.Changed:Connect(function()
                        if input.UserInputState == Enum.UserInputState.End and activeTouch == input then
                            activeTouch = nil
                        end
                    end)
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if mouseDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    setFromX(input.Position.X, true)
                elseif activeTouch and input == activeTouch then
                    setFromX(input.Position.X, true)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    mouseDragging = false
                elseif input == activeTouch then
                    activeTouch = nil
                end
            end)
            item.Set = function(v) value=math.clamp(v,min,max); item.Value=value; setFromX(bar.AbsolutePosition.X + ((value-min)/math.max(max-min,0.0001))*bar.AbsoluteSize.X, true) end
            item.RefreshTheme = function(t) row.BackgroundColor3=t.Surface2; label.TextColor3=t.Text; valueLabel.TextColor3=t.Muted; bar.BackgroundColor3=t.Stroke; fill.BackgroundColor3=t.Accent end
